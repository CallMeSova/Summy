# ============================================================================
# Summy — Environment Variables (Copy to .env.local for local dev or set in Vercel)
# NEVER prefix any of these variables with NEXT_PUBLIC_
# ============================================================================

# 1. Session Signing Secret (Required in production — generate with: openssl rand -base64 32)
AUTH_SECRET=

# 2. Google OAuth 2.0 Credentials (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI:
#   - Local:      http://localhost:3000/api/auth/callback/google
#   - Production: https://your-domain.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional base URL override (auto-detected from request origin if omitted)
# AUTH_URL=https://your-domain.vercel.app

# 3. Turso Cloud SQLite Database (https://turso.tech)
# Leave blank locally to use file:storage/summy.db automatically.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
